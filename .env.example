# DentaVue Docker / local deployment environment template
# Copy this file to .env and fill in the real values.

NODE_ENV=production
PORT=4000
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000
COOKIE_SAMESITE=lax

# Frontend build-time public settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase required settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Optional database / redis settings
DATABASE_URL=
REDIS_URL=

# Optional Gemini analysis settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_NARRATIVE_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_MEDIA_RESOLUTION=MEDIUM
GEMINI_TIMEOUT_MS=60000
AI_ANALYSIS_ENABLED=true
DISABLE_RATE_LIMIT=false
